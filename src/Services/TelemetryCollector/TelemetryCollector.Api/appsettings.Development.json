{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "TelemetryLogs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [Corr:{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]

  },
  "ConnectionStrings": {
    "TelemetryDb": "Server=localhost;Database=TelemetryCollectorDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "ServiceHealthMonitoring": {
    "IntervalSeconds": 30,
    "Services": [
      {
        "BaseUrl": "https://localhost:7000",
        "ServiceName": "Orders",
        "HealthEndpoint": "/health"

      },
      {
        "BaseUrl": "https://localhost:7001",
        "ServiceName": "Payments",
        "HealthEndpoint" : "/health"
      }
    ]
  }
}
